# Copy this file to .env for local development.
# Do not place real passwords, tokens, or private keys in this file.

# Application display name.
APP_NAME=wifi-chat

# Runtime mode, for example: development or production.
APP_ENV=development

# Host address used by the local application server.
APP_HOST=127.0.0.1

# Port used by the local application server.
APP_PORT=3000

# Secret used to sign sessions or other application data.
# Generate a unique value locally and keep it only in .env.
APP_SECRET=replace-with-a-local-secret

# Database connection string, when a database is added.
DATABASE_URL=replace-with-a-local-database-url
